[Unit]
Description=ZFS property-driven Proxmox Backup Server backup
Documentation=https://github.com/ndemarco/zpbs-backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/zpbs-backup run
# Connection settings are ZFS properties (zpbs:repository and friends); token
# secrets are in /etc/zpbs-backup/credentials. Reporting settings
# (ZPBS_PUSHGATEWAY, ZPBS_TEXTFILE_DIR, ZPBS_SYSLOG, ZPBS_NOTIFY) are set with
# Environment= in a drop-in: systemctl edit zpbs-backup.service

# Overlapping runs are prevented by an exclusive flock the command itself
# takes, which also covers a manual `zpbs-backup run`. 75 is what it exits
# with when another run already holds that lock — a deferral, not a failure.
SuccessExitStatus=75

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
# Need network for PBS
PrivateNetwork=false
# Need access to ZFS commands
ReadWritePaths=/dev/zfs

# /var/lib/zpbs-backup, created with the right ownership and writable despite
# ProtectSystem=strict. Holds the run lock.
StateDirectory=zpbs-backup
StateDirectoryMode=0750

# node_exporter's default textfile collector directory, so ZPBS_TEXTFILE_DIR
# works on a stock install. The leading "-" keeps a host without
# node_exporter from failing to start. A collector directory elsewhere needs
# a drop-in adding that path here.
ReadWritePaths=-/var/lib/node_exporter/textfile_collector

[Install]
WantedBy=multi-user.target
